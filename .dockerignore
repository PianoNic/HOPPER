# At the repo root, not beside the Dockerfile. BuildKit reads the ignore file relative to the BUILD
# CONTEXT, and both compose.yml and the release workflow build with `context: .` - a .dockerignore
# under src/HOPPER.API/ is never opened, and every exclusion below silently does nothing.
**/.classpath
**/.dockerignore
**/.env
**/.git
**/.gitignore
**/.project
**/.settings
**/.toolstarget
**/.vs
**/.vscode
**/*.*proj.user
**/*.dbmdl
**/*.jfm
**/azds.yaml
**/bin
**/charts
**/compose*
**/docker-compose*
**/Dockerfile*
**/node_modules
**/npm-debug.log
**/obj
**/dist
**/.angular
**/out-tsc
**/secrets.dev.yaml
**/values.dev.yaml
**/*.db
**/blobs

# Gradle output. Per-module now that the locator is a multi-module build - the locator stage copies
# the whole src/HOPPER.Locator directory, so a host build/ would ride in and hand Gradle stale
# outputs to decide it has nothing to do.
src/HOPPER.Locator/*/build
src/HOPPER.Locator/.gradle

LICENSE
README.md
!**/.gitignore
