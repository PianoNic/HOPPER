<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mediator.Abstractions" Version="3.0.2" />
    <!-- The pack importer lives here rather than in Infrastructure because it is the layer that
         already owns "how a jar becomes a Mod row" - ModFileNameValidator and the duplicate rule are
         both here, and duplicating them across the boundary is how the two would drift. These three
         are what a background worker needs: a typed HTTP client, BackgroundService, and a logger. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <!-- Modrinth's tag lists and project details are re-read constantly while an admin browses and
         while the resolver walks a tree, and their rate limit is 300 requests a minute per address. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HOPPER.Domain\HOPPER.Domain.csproj" />
    <ProjectReference Include="..\HOPPER.Infrastructure\HOPPER.Infrastructure.csproj" />
  </ItemGroup>

</Project>
