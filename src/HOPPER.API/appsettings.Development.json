{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Development runs the dashboard and the API as two origins - `bun start` serves the SPA from
  // :4200 and environment.ts points it at the API on :5170 - so every dashboard call is
  // cross-origin and the browser blocks it unless the API says otherwise. A deployed HOPPER serves
  // the SPA from its own wwwroot and is same-origin, which is why this list is empty there.
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },

  // Read by GET /api/app, which is the only thing the SPA can call before it has a token: it is
  // what tells the SPA where to get one. Points at the throwaway IdP in compose.dev.yml
  // (`docker compose -f compose.dev.yml up -d`), which signs tokens without a login form.
  // RedirectUri is :4200, not :5170, because the browser lands back on the SPA, not on the API.
  "Oidc": {
    "Authority": "http://localhost:58539/default",
    "ClientId": "hopper",
    "RedirectUri": "http://localhost:4200/",
    "PostLogoutRedirectUri": "http://localhost:4200/",
    "Scope": "openid profile email roles",
    "RequireHttpsMetadata": false
  },

  "Hopper": {
    // The directory of templates GET /api/servers/{id}/jar patches a copy of, one per loader
    // generation. Produced by `cd src/HOPPER.Locator && ./gradlew templates`; resolved relative to the
    // API's output directory, which is where AppContext.BaseDirectory points under `dotnet run`.
    // Until that task has been run the jar endpoint answers 503 and names the missing file - it never
    // serves a half-patched jar.
    "LocatorTemplateDirectory": "../../../../HOPPER.Locator/build/templates"
  }
}
