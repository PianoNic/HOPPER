# Copy to .env and fill in. `docker compose` reads this file, and every value in it overrides the
# demo default in compose.yml - a local demo needs no .env at all, this exists for a real
# deployment.
#
# That only holds because compose.yml writes `${Oidc__Authority:-...}` rather than a literal.
# Compose ranks an inline `environment:` value above `env_file`, so a literal there would beat
# anything set here without saying so. Keep the interpolation shape when adding a setting, or the
# new one will silently ignore this file.
#
# The bundled mock IdP is behind a profile and does not start unless you ask for it:
#   docker compose --profile demo up -d     # try it out, no configuration needed
#   docker compose up -d                    # real deployment, the Oidc__* below apply

# ---------- Client tokens ----------
# Client tokens are per server and minted by HOPPER itself. Each server has exactly one; it gates
# GET /api/manifest, GET /api/blobs/{sha256} and POST /api/clients/report for that server and
# nothing else, and the admin surface stays OIDC-only. A token presented that matches no server is
# a 401, and a database with no servers rejects every client rather than opening the door.
#
# You do not configure them here. Create a server in the dashboard and download its jar - the jar
# already carries the token - or read the token off the server's setup page for a manual install.
#
# The one exception: the token given to the "Default" server that is created on an empty database,
# so a first `docker compose up` is usable without a round trip through the dashboard. Applied only
# while the Servers table is empty, so rotating later sticks.
#
# LEAVE THIS UNSET unless something already holds a token HOPPER has to match. Unset means HOPPER
# mints a random one and shows it on the server's setup page, which is both safer and less work than
# inventing one here - and a literal left at its example value is a credential anyone reading this
# repository already knows.
# Generate with: openssl rand -hex 32
# Hopper__BootstrapClientToken=

# ---------- Public base URL ----------
# The host clients are told to download jars from, written into every manifest URL. Leave unset
# behind a proxy that sends X-Forwarded-Proto / X-Forwarded-Host - the manifest derives it from
# the request. Set it when the proxy does not, or when clients dial a different name than the
# API sees.
# Hopper__PublicBaseUrl=https://hopper.example.com

# ---------- OIDC (dashboard admins only) ----------
# Authority is the issuer the browser will be redirected to; the values below are echoed by
# GET /api/app, which is how the SPA configures itself. RedirectUri must be the dashboard's own
# origin, which for a deployed HOPPER is the API's origin, because the API serves the SPA.
Oidc__Authority=https://id.example.com/realms/hopper
Oidc__ClientId=hopper
Oidc__RedirectUri=https://hopper.example.com/
Oidc__PostLogoutRedirectUri=https://hopper.example.com/
Oidc__Scope=openid profile email roles
Oidc__RequireHttpsMetadata=true

# The role an account must carry in the `roles` claim to administer HOPPER. Defaults to
# hopper-admin, and that default matters: without a role requirement, EVERY account your issuer
# knows about is a full HOPPER admin - able to read every server's client token and delete servers
# outright. If you point Authority at the realm you already run for other things, that is every user
# of every one of them.
#
# Grant the role in your IdP (Keycloak: a realm role named below, assigned to your own account, with
# a mapper putting realm roles into a `roles` claim). Set this to empty to go back to "any
# authenticated user", which is a reasonable choice for a realm HOPPER is the only client of.
# Oidc__AdminRole=hopper-admin

# Which `aud` values a token may carry. Defaults to Oidc__ClientId, which is what a correctly
# configured issuer stamps into a token minted for HOPPER. Set this when yours puts something else
# there - Keycloak without an audience mapper emits "account".
# Oidc__ValidAudiences__0=hopper

# Last resort for an issuer that emits nothing usable in aud. Turning this off means a token minted
# for ANY client on the same issuer opens HOPPER's admin surface, so prefer fixing the audience.
# Oidc__ValidateAudience=true
# Set only when the API reaches the IdP on a different address than the browser does
# (compose networks, split-horizon DNS). Metadata is fetched from here, the token's issuer is
# still validated against Oidc__Authority.
# Oidc__InternalAuthority=http://idp:8080/default

# ---------- CORS ----------
# Only needed when the dashboard is served from a different origin than the API. A deployed
# HOPPER serves the SPA from its own wwwroot and is same-origin, so leave this unset.
# The split dev setup (`bun start` on :4200) is configured in appsettings.Development.json.
# Cors__AllowedOrigins__0=http://localhost:4200

# ---------- Database ----------
# HOPPER is Postgres-only. compose.yml points this at its own `db` service; set it here for an
# external Postgres. Change the password from the compose default before exposing the stack.
# ConnectionStrings__HopperDatabase=Host=db;Port=5432;Database=hopper;Username=hopper;Password=hopper

# ---------- Storage ----------
# The content-addressed jar store. Defaults to /data in the image, which compose.yml backs with
# the hopper-data volume. The database is a separate service and is not stored here.
# Blobs__Directory=/data/blobs
